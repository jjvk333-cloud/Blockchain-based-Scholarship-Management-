# ScholarTrust Environment Configuration Example
# Copy this file to .env or export these variables in your environment

# Server
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/scholartrust_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME

# File Upload Storage Directory
UPLOAD_DIR=uploads/documents

# JWT Security
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_256_BITS
JWT_EXPIRATION=86400000

# Blockchain Integration (Ganache Local Network)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0xe78A0F7E598Cc8b0Bb87894B0F60dD2a88d6a8Ab
BLOCKCHAIN_ADMIN_PRIVATE_KEY=CHANGE_ME_WITH_YOUR_BLOCKCHAIN_ACCOUNT_PRIVATE_KEY
